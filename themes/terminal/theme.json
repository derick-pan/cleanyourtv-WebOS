  "w": 326,
  "h": 184,
  "gap": 24,
  "radius": 0,
  "tileFrost": 0.35,
  "tileFrostColor": "#020803",
  "lift": 0,
  "focusScale": 1.02
 },
 "grid": {
  "mode": "below",
