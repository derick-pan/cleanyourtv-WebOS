{
 "name": "Terminal",
 "author": "derick-pan",
 "description": "A terminal: green phosphor text on black, in a monospace typeface, a prompt before the app's name with a blinking cursor, square tiles and buttons drawn as boxes, scanlines and a soft tube glow.",
 "colors": {
  "night": "#040705",
  "panel": "#0b1a0f",
  "ink": "#4dff88",
  "accent": "#4dff88",
  "focus": "#4dff88",
  "pill": "#4dff88"
 },
 "surface": {
  "pillAlpha": 0.04,
  "pillRing": 0.55,
  "pillRadius": 0,
  "menuAlpha": 0.96,
  "rowRadius": 0
 },
 "type": {
  "font": "mono",
  "scale": 0.95
 },
 "clock": {
  "layout": "stack",
  "greeting": true,
  "align": "left",
  "x": 96,
  "y": 54,
  "scale": 1,
  "dateScale": 0.85,
  "weight": 400
 },
 "bar": {
