{
 "name": "Terminal",
 "author": "derick-pan",
 "description": "Just a terminal: green phosphor text on black in a monospace typeface, the time as the output of date, the apps listed one per line under ls, the focused line in inverse video, a prompt with a blinking cursor, and scanlines behind it all.",
 "colors": {
  "night": "#040705",
  "panel": "#0b1a0f",
  "ink": "#4dff88",
  "accent": "#4dff88",
  "focus": "#4dff88",
  "pill": "#4dff88"
 },
 "surface": {
  "pillAlpha": 0,
  "pillRing": 0,
  "pillRadius": 0,
  "menuAlpha": 0.97,
  "rowRadius": 0
 },
 "type": {
  "font": "mono",
  "scale": 0.95
 },
 "clock": {
  "layout": "inline",
  "prefix": "$ date",
  "align": "left",
  "x": 96,
  "y": 60,
  "scale": 0.72,
  "dateScale": 1,
  "weight": 400,
  "ampm": true
 },
 "bar": {
  "style": "flat",
  "labels": "show",
  "size": 48,
  "gap": 8,
  "align": "right",
  "x": 96,
  "y": 60
 },
 "shelf": {
  "show": true,
  "align": "left",
  "x": 96,
  "y": 212,
  "scale": 0.45,
  "prefix": "$ open ",
  "cursor": true
 },
 "dock": {
  "show": false
 },
 "grid": {
  "mode": "below",
  "x": 96,
  "width": 1000,
  "y": 360,
  "cols": 1,
  "tileH": 44,
  "gapX": 6,
  "gapY": 2,
  "radius": 0,
  "clipTop": 300,
  "focusScale": 1,
  "prefix": "$ ls apps/"
 },
 "tile": {
  "style": "text",
  "marker": "> ",
  "gloss": 0,
  "border": 0,
  "ringWidth": 0,
  "ringOffset": 0
 },
 "effects": {
  "glow": 0.25,
  "glowColor": "accent",
  "speed": 0.8,
  "wallpaper": "terminal.png",
  "wallpaperDim": 0
 }
}
