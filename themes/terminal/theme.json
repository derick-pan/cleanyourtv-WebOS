  "tileH": 120,
  "gapX": 24,
  "gapY": 24,
  "radius": 0,
  "clipTop": 300,
  "focusScale": 1.04
 },
 "tile": {
  "gloss": 0,
  "border": 0.22,
  "ringWidth": 2,
  "ringOffset": 4
 },
